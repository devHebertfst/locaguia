# Copie para .env.local e preencha. Só as variáveis do bloco "Obrigatórias"
# são necessárias para rodar o app; as demais ligam recursos opcionais.

# --- Obrigatórias -----------------------------------------------------------
# Supabase > botão "Connect". Em desenvolvimento a conexão direta funciona;
# na Vercel use o pooler em modo transação (porta 6543), porque a conexão
# direta é só IPv6.
DATABASE_URL=postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Migrações (drizzle-kit): conexão direta ou pooler em modo sessão (porta 5432)
DATABASE_URL_DIRETA=postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# Supabase > Project Settings > Data API e API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# Chave publishable (nos projetos antigos, a "anon": use NEXT_PUBLIC_SUPABASE_ANON_KEY)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secret / service_role: só o painel admin precisa (envio de fotos)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_FOTOS=equipamentos
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Assistente (Gemini) ----------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Usado quando o principal está sobrecarregado (erro 503) ou falha
GEMINI_MODEL_RESERVA=gemini-flash-latest

# --- Cloudflare Turnstile (anti-spam) ---------------------------------------
# Sem as chaves, a verificação é pulada (útil em desenvolvimento).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Contato da loja --------------------------------------------------------
# Celular com DDI e DDD, só números. Ex.: 5511912345678
WHATSAPP_LOJA=

# --- E-mail de notificação (Resend) -----------------------------------------
RESEND_API_KEY=
EMAIL_REMETENTE="LocaGuia <avisos@seudominio.com.br>"
EMAIL_DESTINO=

# --- Avisos aos clientes (WhatsApp Cloud API) -------------------------------
# Sem token e número, os avisos ficam pendentes na fila e saem depois. Crie na
# Meta os templates equipamento_chegou, equipamento_disponivel e
# equipamento_desativado (textos e parâmetros em src/lib/avisos/templates.ts).
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_IDIOMA=pt_BR
# Protege a rota do Vercel Cron que reenvia avisos pendentes (sem ele, a rota
# recusa tudo). Na Vercel, a variável com este nome é enviada pelo próprio Cron.
CRON_SECRET=

# --- Limites de uso ---------------------------------------------------------
LIMITE_ASSISTENTE_MENSAGENS_CONVERSA=20
LIMITE_ASSISTENTE_POR_IP_HORA=30
LIMITE_ASSISTENTE_DIARIO=500
LIMITE_FORMULARIOS_POR_IP_HORA=5
